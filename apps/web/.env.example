# Variables d'environnement de Vupay. Copier en `.env.local` (jamais commité).
# Aucune valeur réelle ici.

# Supabase (Réglages du projet → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Côté serveur uniquement (Edge Functions, webhooks) — ne jamais exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Adresse publique de l'app (liens courts /c/[code])
NEXT_PUBLIC_APP_URL=https://vupay.app

# Sel pour hacher les adresses IP des clics (32 caractères aléatoires minimum)
SEL_HACHAGE_IP=

# Agrégateur Mobile Money (FeexPay, pawaPay ou CinetPay : à choisir) — mode test d'abord
PAIEMENT_FOURNISSEUR=sandbox
PAIEMENT_CLE_API=
PAIEMENT_SECRET_WEBHOOK=

# OCR / vision des captures (appelé depuis l'Edge Function verifier-preuve)
VISION_CLE_API=

# OTP et notifications (WhatsApp Business API ou SMS local)
OTP_FOURNISSEUR=
OTP_CLE_API=
